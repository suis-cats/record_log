{
  "name": "research-recorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build && node --check recorder-electron.mjs && node --check recorder-preload.cjs",
    "recorder": "npm run build && electron recorder-electron.mjs",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-recorder-portable.ps1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
